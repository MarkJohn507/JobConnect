rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // -----------------------------
    // Admins
    // -----------------------------
    match /admins/{adminId} {
      allow read: if signedIn() && request.auth.uid == adminId;
      allow create: if signedIn() && request.auth.uid == adminId;
      allow update: if signedIn() && request.auth.uid == adminId;
      allow delete: if false;
    }

    // -----------------------------
    // Users
    // -----------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // -----------------------------
    // Applications
    // -----------------------------
    match /applications/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin()) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // -----------------------------
    // Documents
    // -----------------------------
    match /documents/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // -----------------------------
    // Settings
    // -----------------------------
    match /settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // -----------------------------
    // Benchmark approval settings
    // -----------------------------
    match /benchmarkSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // -----------------------------
    // Benchmark reports
    // -----------------------------
    match /benchmarkReports/{reportId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // -----------------------------
    // Audit logs
    // -----------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
  }
}